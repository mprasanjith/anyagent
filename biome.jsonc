{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "javascript": {
    "globals": ["Bun"]
  },
  "files": {
    "includes": [
      "!!**/dist",
      "!!**/.next",
      "!!**/.source",
      "!!**/.turbo",
      "!!**/test/fixtures",
      "!!apps/web/public"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // Biome's inference collapses dynamically shaped JSON discriminants to
        // never and misreads their switches as unreachable; tsc types them
        // correctly and strict mode guards the unknown-type branches.
        "noUnnecessaryConditions": "off"
      }
    }
  }
}
