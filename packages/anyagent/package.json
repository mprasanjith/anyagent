{
  "name": "anyagent",
  "version": "0.0.0",
  "description": "Detect and drive the coding-agent CLI a user already has installed.",
  "license": "MIT",
  "bin": {
    "anyagent-record": "./dist/cli/record.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./ndjson": {
      "types": "./dist/ndjson.d.ts",
      "import": "./dist/ndjson.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code.d.ts",
      "import": "./dist/claude-code.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "import": "./dist/codex.js"
    },
    "./cline": {
      "types": "./dist/cline.d.ts",
      "import": "./dist/cline.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./goose": {
      "types": "./dist/goose.d.ts",
      "import": "./dist/goose.js"
    },
    "./kilo-code": {
      "types": "./dist/kilo-code.d.ts",
      "import": "./dist/kilo-code.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "types": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  }
}
