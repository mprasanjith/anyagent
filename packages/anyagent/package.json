{
  "name": "anyagent",
  "version": "0.0.0",
  "description": "Detect and drive the coding-agent CLI a user already has installed.",
  "license": "MIT",
  "bin": {
    "anyagent-record": "./dist/cli/record.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "import": "./dist/claude-code/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "types": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  }
}
