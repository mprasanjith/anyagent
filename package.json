{
  "name": "anyagent",
  "version": "0.0.0",
  "description": "Detect and drive the coding-agent CLI a user already has installed.",
  "license": "MIT",
  "bin": {
    "anyagent-record": "./dist/cli/record.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "import": "./dist/claude-code/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "types": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.0",
    "ultracite": "^7.8.0"
  }
}
